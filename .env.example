# Backend (server/)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
# Optional: creates/updates an admin account on startup
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Optional: comma-separated origins allowed to call the API (default: any)
# CORS_ORIGIN=https://your-site.onrender.com
PORT=5000

# Frontend (only needed if the API lives on a different origin; default is /api)
# VITE_API_BASE_URL=https://your-api.onrender.com/api
